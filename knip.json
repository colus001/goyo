{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/desktop-api.d.ts",
        "src/renderer/main.tsx"
      ],
      "ignore": [
        "src/renderer/library-header.tsx",
        "src/renderer/library-overlays.tsx",
        "src/renderer/library-screen.tsx",
        "src/renderer/new-book-modal.tsx"
      ],
      "ignoreDependencies": ["lucide-react", "tailwindcss"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "ignoreBinaries": ["wrangler"],
      "ignoreDependencies": ["wrangler"]
    }
  }
}
