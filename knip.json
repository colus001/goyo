{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/web": {
      "project": ["app/**/*.{css,ts,tsx}", "src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "scripts/notarize.cjs",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/desktop-api.d.ts",
        "src/renderer/main.tsx"
      ],
      "ignoreDependencies": ["tailwindcss"],
      "project": ["scripts/**/*.cjs", "src/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "app/**/*.tsx"],
      "ignoreDependencies": ["isomorphic-webcrypto"]
    }
  }
}
