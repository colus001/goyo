{
  "name": "writer",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first writing app for essays and fiction.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @writer/desktop dev",
    "dev:desktop": "pnpm --filter @writer/desktop dev",
    "dev:web": "pnpm --filter @writer/web dev",
    "dev:worker": "pnpm --filter @writer/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && knip && pnpm typecheck",
    "check:write": "biome check --write . && knip && pnpm typecheck",
    "knip": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "latest",
    "knip": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@10.33.4"
}
