{
  "name": "writer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first writing app for essays and fiction.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:desktop": "pnpm --filter @writer/desktop dev",
    "dev:landing": "pnpm --filter @writer/landing dev",
    "dev:worker": "pnpm --filter @writer/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && knip && turbo run typecheck && pnpm test",
    "check:write": "biome check --write . && knip && turbo run typecheck && pnpm test",
    "knip": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "latest",
    "knip": "latest",
    "turbo": "^2.9.18",
    "typescript": "latest",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
