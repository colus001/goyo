# GitHub Actions / Wrangler deploy
# Add these as GitHub repository secrets before enabling deploy workflows.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional local Wrangler deploy usage.
# Export these in your shell before running `pnpm --filter @writer/worker deploy`
# or `pnpm --filter @writer/web deploy`.
# export CLOUDFLARE_API_TOKEN=...
# export CLOUDFLARE_ACCOUNT_ID=...

# Desktop signing placeholders.
# These are not required for unsigned CI packaging or initial GitHub releases.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
