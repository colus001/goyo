{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goyo-cloud-web",
  "compatibility_date": "2026-06-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "goyo-cloud.seokjun.kim",
      "custom_domain": true
    }
  ]
}
