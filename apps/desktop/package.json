{
  "name": "@writer/desktop",
  "private": true,
  "version": "0.1.5",
  "description": "Distraction-free long-form writing desktop app.",
  "author": {
    "name": "Seokjun Kim",
    "email": "seokjun@seokjun.kim"
  },
  "homepage": "https://goyo.seokjun.kim",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "pack": "pnpm build && electron-builder --dir --publish never",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b"
  },
  "build": {
    "afterSign": "scripts/notarize.cjs",
    "appId": "kim.seokjun.goyo",
    "executableName": "goyo",
    "icon": "build/icon",
    "productName": "Goyo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "executableName": "Goyo",
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "type": "link",
          "path": "/Applications",
          "x": 480,
          "y": 170
        }
      ],
      "icon": "build/icon.icns",
      "iconSize": 104,
      "title": "Goyo ${version}",
      "window": {
        "height": 380,
        "width": 660
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Seokjun Kim <seokjun@seokjun.kim>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@writer/core": "workspace:*",
    "@writer/editor": "workspace:*",
    "@writer/shared": "workspace:*",
    "@writer/ui": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2"
  }
}
