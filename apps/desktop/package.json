{
  "name": "@writer/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "pack": "pnpm build && electron-builder --dir --publish never",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b"
  },
  "build": {
    "appId": "kim.seokjun.goyo",
    "productName": "Goyo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@writer/core": "workspace:*",
    "@writer/editor": "workspace:*",
    "@writer/shared": "workspace:*",
    "@writer/ui": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2"
  }
}
