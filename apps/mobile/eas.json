{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_GOYO_CLOUD_API_URL": "https://goyo-api.seokjun.kim"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOYO_CLOUD_API_URL": "https://goyo-api.seokjun.kim"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824169958"
      }
    }
  }
}
