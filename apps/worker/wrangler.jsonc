{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goyo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_EMAIL_FROM": "Goyo <no-reply@goyo.seokjun.kim>"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "writer-sync",
      "database_id": "a1577590-0b95-4bfb-9103-e224ef86407d",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "goyo-api.seokjun.kim",
      "custom_domain": true
    }
  ]
}
